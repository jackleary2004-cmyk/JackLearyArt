<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<title>Surf — Jack Leary</title>
<meta name="description" content="Surf: an editorial presentation and the Surf in Monochrome gallery series by Jack Leary.">
<style>
  /* League Mono — same real, self-hosted font files as home-v2-prototype.html. */
  @font-face {
    font-family: "League Mono";
    src: url("/fonts/league-mono/LeagueMono-Thin.woff2") format("woff2");
    font-weight: 100;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "League Mono";
    src: url("/fonts/league-mono/LeagueMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "League Mono";
    src: url("/fonts/league-mono/LeagueMono-ExtraBold.woff2") format("woff2");
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
  /* League Spartan — new header/display typeface, self-hosted the same
     way as League Mono (real file, copied from the LeagueSpartan-2.220
     folder into src/fonts/league-spartan/). Only ExtraBold is needed
     since every header/title on the site uses weight 800. */
  @font-face {
    font-family: "League Spartan";
    src: url("/fonts/league-spartan/LeagueSpartan-ExtraBold.woff2") format("woff2");
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
</style>
<style>
  /*
    PROTOTYPE NOTES:
    - UPDATED to the new site-wide style guide (black bg, stark white text,
      red/yellow/blue accents, sharp corners everywhere, League Mono in
      place of the old Neue Haas Grotesk placeholder — matching what
      home-v2-prototype.html now uses). This pass ONLY touches the visual
      system: colors, background, type, and forcing border-radius to 0.
      Nothing about the layout, the masonry grid, the ripple hover effect,
      or the lightbox/slideshow behavior was touched — all exactly as
      before. Old font-weights that don't exist in League Mono's set
      (300, 200, 900) were mapped to the nearest real weight we have
      (100 Thin, 100 Thin, 800 ExtraBold respectively).
    - v4: 9 columns (was 10). Removed the blue "SURF" eyebrow above the
      title. Hover-expand is back to a true ripple: the layout itself never
      changes (still zero-crop masonry — nothing is quantized or reflowed
      for real), but nearby tiles get a small `transform: translate(...)`
      push away from the hovered tile, sized by distance (closer = bigger
      push) with a matching per-tile animation delay so it visibly radiates
      outward, plus a slight overshoot ease so it settles rather than
      snapping — that's the "rock into water" feel. Because it's all
      transform-based (no real box resizing), it can't reintroduce the
      cropping/black-gap problem from before.
    - Videos still autoplay muted on hover in the grid, full controls+sound
      in the slideshow.
  */

  * { border-radius: 0 !important; } /* sharp corners everywhere, per style guide */

  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --white: #ffffff;
    --black: #000000;
    --red:   #eb1c1c;
    --blue:  #48acf0;
    --yellow:#f0e100;

    /* Fluid side margin — see intro-prototype.html for the full note.
       390px -> 24px, 1512px (14" MacBook Pro logical width) -> 100px,
       holds flat past that. Untouched by this pass — it's a layout value,
       not part of the color/type style guide. */
    --side-pad: clamp(24px, calc(-2.4px + 6.77vw), 100px);
    --font-display: "League Spartan", "Helvetica Neue", Arial, sans-serif;
    --font-body:    "League Mono", "Helvetica Neue", Arial, monospace;
    --font-caption: "League Mono", "Helvetica Neue", Arial, monospace;
  }

  html, body {
    background: var(--black);
    color: var(--white);
    font-family: var(--font-body);
  }

  a { color: inherit; text-decoration: none; }

  /* ---------- HEADER ---------- */

  .back-link {
    position: fixed;
    top: clamp(78px, 14vh, 112px); /* clears the sticky top-bar */
    left: var(--side-pad);
    z-index: 20;
    font-family: var(--font-caption);
    font-weight: 100;
    font-size: clamp(12px, 1.4vw, 15px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255,255,255,0.55);
    transition: color 0.3s ease, font-weight 0.1s ease;
  }
  .back-link:hover { color: var(--blue); text-decoration: underline; text-underline-offset: 4px; }

  .project-header {
    padding: 7rem var(--side-pad) 3.5rem;
    max-width: 760px;
  }

  .project-header h1 {
    font-family: var(--font-display);
    font-weight: 800; /* League Mono's heaviest real weight (ExtraBold) — was a synthetic 900 */
    text-transform: uppercase;
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .project-header p.body-copy {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255,255,255,0.8);
    max-width: 620px;
    margin-bottom: 1.1rem;
  }

  .project-header .caption {
    font-family: var(--font-caption);
    font-weight: 100;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6) /* was 0.4–0.45: raised to pass 4.5:1 on black */;
  }

  /* Small caption-sized year line, sitting right under the title. */
  .project-year {
    font-family: var(--font-caption);
    font-weight: 100;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6) /* was 0.4–0.45: raised to pass 4.5:1 on black */;
    margin-bottom: 1rem;
  }

  /* ---------- GRID (column masonry, no cropping / no rounding gaps) ---- */

  .surf-grid {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    padding: 0 var(--side-pad) 4px;
  }

  .surf-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 0;
    min-width: 0;
  }

  .surf-tile {
    position: relative;
    cursor: pointer;
    /* transform/z-index are managed inline via JS (ripple), not by a class —
       see rippleFrom() below */
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .surf-tile img,
  .surf-tile video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
  }

  .surf-tile .type-badge {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(10,10,10,0.6);
    color: var(--white);
    font-size: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .grid-loading {
    padding: 2rem var(--side-pad);
    font-family: var(--font-caption);
    font-weight: 100;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6) /* was 0.4–0.45: raised to pass 4.5:1 on black */;
  }

  /* ---------- SLIDESHOW / LIGHTBOX ---------- */

  #lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  #lightbox.open {
    opacity: 1;
    pointer-events: all;
  }

  #lightbox .stage {
    max-width: 82vw;
    max-height: 82vh;
  }
  #lightbox .stage img,
  #lightbox .stage video {
    max-width: 82vw;
    max-height: 82vh;
    display: block;
  }

  #lightbox .close-btn,
  #lightbox .nav-btn {
    position: absolute;
    background: none;
    border: none;
    color: var(--white);
    cursor: pointer;
    font-family: var(--font-caption);
  }

  #lightbox .close-btn {
    top: 24px;
    right: var(--side-pad);
    font-size: 28px;
    line-height: 1;
    font-weight: 100;
  }
  #lightbox .close-btn:hover { color: var(--yellow); }

  #lightbox .nav-btn {
    top: 50%;
    transform: translateY(-50%);
    font-size: 40px;
    font-weight: 100;
    padding: 0.5rem 1rem;
  }
  #lightbox .nav-btn:hover { color: var(--yellow); }
  #lightbox .nav-prev { left: 12px; }
  #lightbox .nav-next { right: 12px; }

  #lightbox .index-label {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-caption);
    font-weight: 100;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.6);
  }

  /* Same overlay, scoped to its own ID so it can run independently of the
     main deck's #lightbox (separate FILES set, separate open/close state). */
  #monoLightbox {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.96);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  #monoLightbox.open {
    opacity: 1;
    pointer-events: all;
  }

  #monoLightbox .stage {
    max-width: 82vw;
    max-height: 82vh;
  }
  #monoLightbox .stage img {
    max-width: 82vw;
    max-height: 82vh;
    display: block;
  }

  #monoLightbox .close-btn,
  #monoLightbox .nav-btn {
    position: absolute;
    background: none;
    border: none;
    color: var(--white);
    cursor: pointer;
    font-family: var(--font-caption);
  }

  #monoLightbox .close-btn {
    top: 24px;
    right: var(--side-pad);
    font-size: 28px;
    line-height: 1;
    font-weight: 100;
  }
  #monoLightbox .close-btn:hover { color: var(--yellow); }

  #monoLightbox .nav-btn {
    top: 50%;
    transform: translateY(-50%);
    font-size: 40px;
    font-weight: 100;
    padding: 0.5rem 1rem;
  }
  #monoLightbox .nav-btn:hover { color: var(--yellow); }
  #monoLightbox .nav-prev { left: 12px; }
  #monoLightbox .nav-next { right: 12px; }

  #monoLightbox .index-label {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-caption);
    font-weight: 100;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.6);
  }

  /* ---------- SURF IN MONOCHROME (collapsible gallery-exhibition sub-section) ---------- */

  .mono-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--yellow);
    color: var(--black);
    cursor: pointer;
    padding: clamp(16px, 2.6vh, 26px) var(--side-pad);
    margin-top: clamp(30px, 5vh, 60px);
    -webkit-user-select: none;
    user-select: none;
  }
  .mono-bar-label,
  .mono-bar-year {
    font-family: var(--font-caption);
    font-weight: 800;
    font-size: clamp(11px, 1.2vw, 13px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    flex: 1 1 0;
  }
  .mono-bar-year {
    text-align: right;
    padding-right: clamp(28px, 4vw, 40px);
  }
  .mono-bar-title {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.1rem, 2.4vw, 1.9rem);
    text-align: center;
    flex: 1 1 0;
  }
  .mono-bar-toggle {
    position: absolute;
    top: 50%;
    right: var(--side-pad);
    transform: translateY(-50%);
    font-family: var(--font-caption);
    font-weight: 800;
    font-size: 22px;
    pointer-events: none;
  }
  .mono-bar {
    position: relative;
  }

  .mono-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mono-gallery-row {
    display: flex;
    gap: 6px;
    padding: clamp(24px, 4vh, 50px) var(--side-pad) clamp(20px, 3vh, 40px);
  }
  .mono-gallery-row .cell {
    flex: 1 1 0;
    min-width: 0;
  }
  .mono-gallery-row .cell img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 700px) {
    .mono-gallery-row { flex-direction: column; }
  }
</style>
</head>
<body>

  {% include "top-bar.njk" %}

  <a class="back-link" href="/work/">← Work</a>

  <header class="project-header">
    <h1>Surf</h1>
  </header>

  <!-- Surf in Monochrome: a gallery-exhibition feature, collapsed by default.
       Bar reads Gallery Exhibition / Surf Monochrome / 2026; opening it
       reveals 3 exhibition install photos, then the full 50-piece set in
       a 10-column grid using the exact same masonry + ripple-hover +
       lightbox pattern as the main deck above. -->
  <div class="mono-bar" id="monoBar" role="button" tabindex="0" aria-expanded="false" aria-controls="monoPanel">
    <span class="mono-bar-label">Gallery Exhibition</span>
    <span class="mono-bar-title">Surf Monochrome</span>
    <span class="mono-bar-year">2026</span>
    <span class="mono-bar-toggle" id="monoBarToggle">+</span>
  </div>

  <div class="mono-panel" id="monoPanel">
    <div id="monoPanelInner">
      <div class="mono-gallery-row">
        <div class="cell"><img src="/images/surf/surf-monochrome/gallery-imgs/img-1_surf-monochrome.webp" alt="Surf Monochrome gallery exhibition, install photo 1" loading="lazy"></div>
        <div class="cell"><img src="/images/surf/surf-monochrome/gallery-imgs/img-2_surf-monochrome.webp" alt="Surf Monochrome gallery exhibition, install photo 2" loading="lazy"></div>
        <div class="cell"><img src="/images/surf/surf-monochrome/gallery-imgs/img-3_surf-monochrome.webp" alt="Surf Monochrome gallery exhibition, install photo 3" loading="lazy"></div>
      </div>

      <div class="grid-loading" id="monoGridLoading">loading 50 pieces…</div>
      <div class="surf-grid" id="monoGrid"></div>
    </div>
  </div>

  <div class="grid-loading" id="gridLoading">loading 74 slides…</div>
  <div class="surf-grid" id="surfGrid"></div>

  <div id="lightbox">
    <button class="nav-btn nav-prev" id="lbPrev" aria-label="Previous">&#8249;</button>
    <div class="stage" id="lbStage"></div>
    <button class="nav-btn nav-next" id="lbNext" aria-label="Next">&#8250;</button>
    <button class="close-btn" id="lbClose" aria-label="Close">&times;</button>
    <div class="index-label" id="lbIndex"></div>
  </div>

  <div id="monoLightbox">
    <button class="nav-btn nav-prev" id="mlbPrev" aria-label="Previous">&#8249;</button>
    <div class="stage" id="mlbStage"></div>
    <button class="nav-btn nav-next" id="mlbNext" aria-label="Next">&#8250;</button>
    <button class="close-btn" id="mlbClose" aria-label="Close">&times;</button>
    <div class="index-label" id="mlbIndex"></div>
  </div>

<script>
(function () {
  // ---- The full 74-slide deck, in order ---------------------------------
  const BASE = "/images/surf/";
  const FILES = [
    "surf_1.webp","surf_2.webp","surf_3.webp","surf_4.webp","surf_5.mp4","surf_6.webp","surf_7.mp4",
    "surf_8.webp","surf_9.webp","surf_10.webp","surf_11.webp","surf_12.mp4","surf_13.webp","surf_14.webp",
    "surf_15.webp","surf_16.webp","surf_17.mp4","surf_18.webp","surf_19.webp","surf_20.webp","surf_21.webp",
    "surf_22.mp4","surf_23.webp","surf_24.mp4","surf_25.webp","surf_26.webp","surf_27.webp","surf_28.webp",
    "surf_29.webp","surf_30.webp","surf_31.webp","surf_32.mp4","surf_33.webp","surf_34.webp","surf_35.webp",
    "surf_36.webp","surf_37.mp4","surf_38.webp","surf_39.webp","surf_40.webp","surf_41.webp","surf_42.mp4",
    "surf_43.webp","surf_44.webp","surf_45.webp","surf_46.mp4","surf_47.webp","surf_48.webp","surf_49.mp4",
    "surf_50.webp","surf_51.mp4","surf_52.webp","surf_53.webp","surf_54.mp4","surf_55.webp","surf_56.mp4",
    "surf_57.webp","surf_58.mp4","surf_59.webp","surf_60.mp4","surf_61.webp","surf_62.webp","surf_63.mp4",
    "surf_64.webp","surf_65.webp","surf_66.webp","surf_67.webp","surf_68.mp4","surf_69.webp","surf_70.webp",
    "surf_71.mp4","surf_72.webp","surf_73.webp","surf_74.webp",
  ];
  const isVideo = (f) => f.endsWith(".mp4");

  const COLUMNS = 9;

  const grid = document.getElementById("surfGrid");
  const gridLoading = document.getElementById("gridLoading");

  // ---- Measure each file's real aspect ratio before laying anything out
  function loadAspect(file) {
    return new Promise((resolve) => {
      if (isVideo(file)) {
        const v = document.createElement("video");
        v.preload = "metadata";
        v.muted = true;
        v.onloadedmetadata = () => resolve((v.videoWidth / v.videoHeight) || 1);
        v.onerror = () => resolve(1);
        v.src = BASE + file;
      } else {
        const im = new Image();
        im.onload = () => resolve(im.naturalWidth / im.naturalHeight);
        im.onerror = () => resolve(1);
        im.src = BASE + file;
      }
    });
  }

  // ---- Ripple: a purely visual (transform-only) effect. Layout/box sizes
  // never change, so this can't reintroduce cropping or rounding gaps. ----
  let allTiles = [];       // flat list of every tile element, built once
  let rippledTiles = [];   // tiles currently displaced, so we can reset them

  function clearRipple() {
    rippledTiles.forEach((tile) => {
      tile.style.transform = "";
      tile.style.transitionDelay = "";
      tile.style.zIndex = "";
      tile.style.boxShadow = "";
    });
    rippledTiles = [];
  }

  function rippleFrom(sourceTile) {
    clearRipple();

    const srcRect = sourceTile.getBoundingClientRect();
    const cx = srcRect.left + srcRect.width / 2;
    const cy = srcRect.top + srcRect.height / 2;
    // The push direction already comes from the real (dx, dy) vector to each
    // tile's center below, so it was never limited to same-column/same-row —
    // it's a true radius in every direction, diagonals included. The reason
    // diagonal neighbors barely moved before is that masonry columns stagger
    // independently, so a "diagonal" tile is often further away in actual
    // pixels than a same-column or same-row one — a tight radius just wasn't
    // reaching it. Both numbers below are bigger now so it reliably does.
    const radius = srcRect.width * 3.6;   // how far the ripple reaches
    const maxPush = srcRect.width * 0.2;  // how far a neighbor gets nudged at most

    // The hovered tile itself: scale up, no delay, lift above everything it overlaps
    sourceTile.style.transform = "scale(1.5)";
    sourceTile.style.transitionDelay = "0ms";
    sourceTile.style.zIndex = "5";
    sourceTile.style.boxShadow = "0 16px 38px rgba(0,0,0,0.4)";
    rippledTiles.push(sourceTile);

    allTiles.forEach((tile) => {
      if (tile === sourceTile) return;
      const r = tile.getBoundingClientRect();
      const tx = r.left + r.width / 2;
      const ty = r.top + r.height / 2;
      const dx = tx - cx, dy = ty - cy;
      const dist = Math.hypot(dx, dy) || 1;
      if (dist >= radius) return;

      // Smooth falloff (1 at the center, ~0.15 floor at the radius edge instead
      // of a hard cutoff to 0) — keeps far/diagonal tiles from dropping out
      // abruptly, so the wave still visibly reaches them.
      const strength = 0.15 + 0.85 * Math.cos((dist / radius) * (Math.PI / 2));
      const push = maxPush * strength;
      const nx = dx / dist, ny = dy / dist;

      tile.style.transform = `translate(${(nx * push).toFixed(1)}px, ${(ny * push).toFixed(1)}px)`;
      // Delay scales with distance so the push visibly radiates outward, like a ripple
      tile.style.transitionDelay = Math.round((dist / radius) * 90) + "ms";
      rippledTiles.push(tile);
    });
  }

  // ---- Build the masonry columns (after every file's aspect is known) ---
  Promise.all(FILES.map(loadAspect)).then((aspects) => {
    gridLoading.remove();

    // Build empty columns first so we can measure a real column's width
    const cols = [];
    const colHeights = new Array(COLUMNS).fill(0); // running height, for shortest-column placement
    for (let c = 0; c < COLUMNS; c++) {
      const col = document.createElement("div");
      col.className = "surf-col";
      grid.appendChild(col);
      cols.push(col);
    }
    const colWidth = cols[0].getBoundingClientRect().width;

    FILES.forEach((file, i) => {
      const aspect = aspects[i];
      const itemHeight = colWidth / aspect;

      // Place into whichever column is currently shortest
      let target = 0;
      for (let c = 1; c < COLUMNS; c++) {
        if (colHeights[c] < colHeights[target]) target = c;
      }
      colHeights[target] += itemHeight;

      const tile = document.createElement("div");
      tile.className = "surf-tile";

      let videoEl = null;
      if (isVideo(file)) {
        tile.innerHTML =
          `<video src="${BASE}${file}" muted loop playsinline preload="metadata"></video>` +
          `<span class="type-badge">&#9654;</span>`;
        videoEl = tile.querySelector("video");
      } else {
        tile.innerHTML = `<img src="${BASE}${file}" alt="Surf slide ${i + 1}" loading="lazy">`;
      }

      tile.addEventListener("mouseenter", () => {
        if (videoEl) videoEl.play().catch(() => {}); // autoplay-on-hover, muted so browsers allow it
        rippleFrom(tile); // instant — no dwell delay, follows the cursor like a touch
      });
      tile.addEventListener("mouseleave", () => {
        if (videoEl) { videoEl.pause(); videoEl.currentTime = 0; }
        clearRipple();
      });
      tile.addEventListener("click", () => openLightbox(i));

      cols[target].appendChild(tile);
      allTiles.push(tile);
    });
  });

  // ---- Lightbox / slideshow ------------------------------------------
  const lightbox = document.getElementById("lightbox");
  const stage = document.getElementById("lbStage");
  const indexLabel = document.getElementById("lbIndex");
  let current = 0;

  function renderStage() {
    const file = FILES[current];
    stage.innerHTML = isVideo(file)
      ? `<video src="${BASE}${file}" controls></video>`
      : `<img src="${BASE}${file}" alt="Surf slide ${current + 1}">`;
    indexLabel.textContent = (current + 1) + " / " + FILES.length;
  }

  function openLightbox(i) {
    current = i;
    renderStage();
    lightbox.classList.add("open");
  }
  function closeLightbox() {
    lightbox.classList.remove("open");
    stage.innerHTML = ""; // stop any playing video
  }
  function step(delta) {
    current = (current + delta + FILES.length) % FILES.length;
    renderStage();
  }

  document.getElementById("lbClose").addEventListener("click", closeLightbox);
  document.getElementById("lbPrev").addEventListener("click", () => step(-1));
  document.getElementById("lbNext").addEventListener("click", () => step(1));
  lightbox.addEventListener("click", (e) => { if (e.target === lightbox) closeLightbox(); });

  window.addEventListener("keydown", (e) => {
    if (!lightbox.classList.contains("open")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
  });
})();

(function () {
  // ---- Surf in Monochrome: 50 pieces, 10-column masonry, same ripple +
  // lightbox mechanism as the main deck above (own closure, own FILES,
  // own lightbox — nothing shared with it). ----
  const BASE = "/images/surf/surf-monochrome/work-imgs/";
  const FILES = Array.from({ length: 50 }, (_, i) => `surf_monochrome_edited_${i + 1}.webp`);

  const COLUMNS = 10;

  const grid = document.getElementById("monoGrid");
  const gridLoading = document.getElementById("monoGridLoading");

  function loadAspect(file) {
    return new Promise((resolve) => {
      const im = new Image();
      im.onload = () => resolve(im.naturalWidth / im.naturalHeight);
      im.onerror = () => resolve(1);
      im.src = BASE + file;
    });
  }

  // ---- Ripple: identical to the main deck's (same radius/push/scale) ----
  let allTiles = [];
  let rippledTiles = [];

  function clearRipple() {
    rippledTiles.forEach((tile) => {
      tile.style.transform = "";
      tile.style.transitionDelay = "";
      tile.style.zIndex = "";
      tile.style.boxShadow = "";
    });
    rippledTiles = [];
  }

  function rippleFrom(sourceTile) {
    clearRipple();

    const srcRect = sourceTile.getBoundingClientRect();
    const cx = srcRect.left + srcRect.width / 2;
    const cy = srcRect.top + srcRect.height / 2;
    const radius = srcRect.width * 3.6;
    const maxPush = srcRect.width * 0.2;

    sourceTile.style.transform = "scale(1.5)";
    sourceTile.style.transitionDelay = "0ms";
    sourceTile.style.zIndex = "5";
    sourceTile.style.boxShadow = "0 16px 38px rgba(0,0,0,0.4)";
    rippledTiles.push(sourceTile);

    allTiles.forEach((tile) => {
      if (tile === sourceTile) return;
      const r = tile.getBoundingClientRect();
      const tx = r.left + r.width / 2;
      const ty = r.top + r.height / 2;
      const dx = tx - cx, dy = ty - cy;
      const dist = Math.hypot(dx, dy) || 1;
      if (dist >= radius) return;

      const strength = 0.15 + 0.85 * Math.cos((dist / radius) * (Math.PI / 2));
      const push = maxPush * strength;
      const nx = dx / dist, ny = dy / dist;

      tile.style.transform = `translate(${(nx * push).toFixed(1)}px, ${(ny * push).toFixed(1)}px)`;
      tile.style.transitionDelay = Math.round((dist / radius) * 90) + "ms";
      rippledTiles.push(tile);
    });
  }

  // ---- Build the masonry columns (after every file's aspect is known) ---
  Promise.all(FILES.map(loadAspect)).then((aspects) => {
    gridLoading.remove();

    const cols = [];
    const colHeights = new Array(COLUMNS).fill(0);
    for (let c = 0; c < COLUMNS; c++) {
      const col = document.createElement("div");
      col.className = "surf-col";
      grid.appendChild(col);
      cols.push(col);
    }
    const colWidth = cols[0].getBoundingClientRect().width;

    FILES.forEach((file, i) => {
      const aspect = aspects[i];
      const itemHeight = colWidth / aspect;

      let target = 0;
      for (let c = 1; c < COLUMNS; c++) {
        if (colHeights[c] < colHeights[target]) target = c;
      }
      colHeights[target] += itemHeight;

      const tile = document.createElement("div");
      tile.className = "surf-tile";
      tile.innerHTML = `<img src="${BASE}${file}" alt="Surf Monochrome piece ${i + 1}" loading="lazy">`;

      tile.addEventListener("mouseenter", () => rippleFrom(tile));
      tile.addEventListener("mouseleave", () => clearRipple());
      tile.addEventListener("click", () => openMonoLightbox(i));

      cols[target].appendChild(tile);
      allTiles.push(tile);
    });

    syncPanelHeight();
  });

  // ---- Lightbox (own instance) -------------------------------------
  const monoLightbox = document.getElementById("monoLightbox");
  const mlbStage = document.getElementById("mlbStage");
  const mlbIndexLabel = document.getElementById("mlbIndex");
  let mlbCurrent = 0;

  function renderMlbStage() {
    const file = FILES[mlbCurrent];
    mlbStage.innerHTML = `<img src="${BASE}${file}" alt="Surf Monochrome piece ${mlbCurrent + 1}">`;
    mlbIndexLabel.textContent = (mlbCurrent + 1) + " / " + FILES.length;
  }
  function openMonoLightbox(i) {
    mlbCurrent = i;
    renderMlbStage();
    monoLightbox.classList.add("open");
  }
  function closeMonoLightbox() {
    monoLightbox.classList.remove("open");
    mlbStage.innerHTML = "";
  }
  function mlbStep(delta) {
    mlbCurrent = (mlbCurrent + delta + FILES.length) % FILES.length;
    renderMlbStage();
  }

  document.getElementById("mlbClose").addEventListener("click", closeMonoLightbox);
  document.getElementById("mlbPrev").addEventListener("click", () => mlbStep(-1));
  document.getElementById("mlbNext").addEventListener("click", () => mlbStep(1));
  monoLightbox.addEventListener("click", (e) => { if (e.target === monoLightbox) closeMonoLightbox(); });

  // ---- Collapsible bar -----------------------------------------------
  const bar = document.getElementById("monoBar");
  const barToggle = document.getElementById("monoBarToggle");
  const panel = document.getElementById("monoPanel");
  const panelInner = document.getElementById("monoPanelInner");

  function syncPanelHeight() {
    if (panel.classList.contains("open")) {
      panel.style.maxHeight = panelInner.scrollHeight + "px";
    }
  }

  function togglePanel() {
    const opening = !panel.classList.contains("open");
    if (opening) {
      panel.classList.add("open");
      bar.classList.add("open");
      bar.setAttribute("aria-expanded", "true");
      barToggle.textContent = "\u2212"; // minus sign
      panel.style.maxHeight = panelInner.scrollHeight + "px";
    } else {
      // Lock in the current height first so collapsing actually animates
      // instead of jumping (max-height was "none"-equivalent via a big
      // pixel value, so this re-measures it before dropping to 0).
      panel.style.maxHeight = panelInner.scrollHeight + "px";
      requestAnimationFrame(() => { panel.style.maxHeight = "0px"; });
      panel.classList.remove("open");
      bar.classList.remove("open");
      bar.setAttribute("aria-expanded", "false");
      barToggle.textContent = "+";
    }
  }

  bar.addEventListener("click", togglePanel);
  bar.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      togglePanel();
    }
  });

  window.addEventListener("keydown", (e) => {
    if (!monoLightbox.classList.contains("open")) return;
    if (e.key === "Escape") closeMonoLightbox();
    if (e.key === "ArrowLeft") mlbStep(-1);
    if (e.key === "ArrowRight") mlbStep(1);
  });

  // Keep the panel's max-height in sync as the grid/gallery-row images
  // finish loading — their real height isn't known up front, which would
  // otherwise clip the reveal or leave a gap underneath.
  const ro = new ResizeObserver(() => syncPanelHeight());
  ro.observe(panelInner);
  window.addEventListener("resize", syncPanelHeight);
})();
</script>
</body>
</html>
