<style>
  /* ---------- TOP BAR (persistent site-wide masthead + nav) ---------- */
  /* Sticky (not fixed) so it always occupies real space at the top of the
     document flow — every page gets pushed down automatically, no manual
     spacer/padding math needed per page. Theme (light/dark) is driven by
     a `top-bar--dark` modifier class added from each page's own
     `topBarTheme` front-matter value, so the bar always reads clearly
     against that page's background instead of sitting as a mismatched
     white slab on the black-background pages. Both rows (masthead and
     nav) span the full page width edge-to-edge via space-between, same
     side padding as everything else on the site (--side-pad). */

  .top-bar {
    position: sticky;
    top: 0;
    z-index: 150; /* below the Contact oval (200/201) so the oval still
                     covers it when open; above ordinary page content. */
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.4vh, 14px);
    padding: clamp(12px, 2vh, 22px) var(--side-pad) clamp(10px, 1.6vh, 16px);
    background: var(--white);
    color: var(--black);
    border-bottom: 1px solid var(--black);
    transition: background-color 0.4s ease, color 0.4s ease,
                border-color 0.4s ease, opacity 0.3s ease;
  }
  .top-bar.top-bar--dark {
    background: var(--black);
    color: var(--white);
    border-bottom-color: var(--white);
  }
  /* Scroll-dimmed state — added once the page has scrolled past the top,
     removed automatically on pages short enough that there's nothing to
     scroll (scrollY never leaves 0). */
  .top-bar.top-bar--scrolled {
    opacity: 0.75;
  }

  .top-bar-masthead,
  .top-bar-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: clamp(10px, 2vw, 28px);
  }

  .top-bar-masthead span,
  .top-bar-nav a {
    font-family: var(--font-body);
    font-weight: 100;
    font-size: clamp(10px, 1.15vw, 14px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: inherit;
    opacity: 0;
    transform: translateY(-6px);
    animation: topBarIn 0.6s ease forwards;
  }

  .top-bar-nav a {
    font-size: clamp(12px, 1.4vw, 15px);
    transition: color 0.35s ease, transform 0.3s ease, opacity 0.3s ease;
  }
  .top-bar-nav a:hover {
    transform: translateY(-3px) scale(1.08);
    font-weight: 800; /* League Mono ExtraBold — the only bold face loaded */
  }
  .top-bar-nav a.top-bar-contact:hover {
    opacity: 0.55;
  }

  .top-bar-logo {
    height: 1.1em; /* 10% larger than the row text, still align-items:center
                       so it stays vertically aligned with the masthead row */
    width: auto;
    display: block;
    opacity: 0;
    animation: topBarIn 0.6s ease forwards;
  }
  /* The mark is drawn solid black — invert it to white on the dark-theme
     pages so it reads against the black bar instead of disappearing. */
  .top-bar.top-bar--dark .top-bar-logo {
    filter: invert(1);
  }

  .top-bar-masthead > *:nth-child(1) { animation-delay: 0.3s; }
  .top-bar-masthead > *:nth-child(2) { animation-delay: 0.15s; }
  .top-bar-masthead > *:nth-child(3) { animation-delay: 0s; }
  .top-bar-nav a:nth-child(1) { animation-delay: 0.3s; }
  .top-bar-nav a:nth-child(2) { animation-delay: 0.2s; }
  .top-bar-nav a:nth-child(3) { animation-delay: 0.1s; }
  .top-bar-nav a:nth-child(4) { animation-delay: 0.05s; }
  .top-bar-nav a:nth-child(5) { animation-delay: 0s; }

  @keyframes topBarIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 700px) {
    .top-bar-masthead,
    .top-bar-nav {
      flex-wrap: wrap;
      row-gap: 6px;
      gap: 10px;
    }
    .top-bar-masthead span { font-size: 9px; letter-spacing: 0.08em; }
    .top-bar-nav a { font-size: 11px; letter-spacing: 0.12em; }
  }

  /* ---------- CONTACT OVERLAY (blue/red/yellow oval, drops from top) ----
     Lives here (not per-page) so the "Contact" nav link works the same
     way on every page that includes this partial — it used to be
     duplicated into index.njk and work.njk only, which meant clicking
     Contact silently did nothing everywhere else (archive + all 6
     project pages). ---------------------------------------------------- */

  .contact-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .contact-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .contact-oval {
    position: fixed;
    top: 8vh;
    left: 50%;
    width: min(56vw, 360px);
    aspect-ratio: 4 / 3.3;
    border-radius: 50% !important;
    background: linear-gradient(135deg, var(--blue) 0%, var(--red) 52%, var(--yellow) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(6px, 1vh, 10px);
    text-align: center;
    padding: 9% 12%;
    transform: translate(-50%, -140%);
    transition: transform 0.75s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 201;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .contact-overlay.open .contact-oval {
    transform: translate(-50%, 0);
  }

  .contact-oval .contact-name {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2.8vw, 2rem);
    color: var(--black);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .contact-oval .contact-email {
    font-family: var(--font-caption);
    font-weight: 400;
    font-size: clamp(12px, 1.3vw, 15px);
    color: var(--black);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-oval .contact-links {
    display: flex;
    gap: clamp(12px, 1.8vw, 24px);
    margin-top: 2px;
  }

  .contact-oval .contact-links a {
    font-family: var(--font-caption);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--black);
    border-bottom: 1px solid rgba(0, 0, 0, 0.4);
    padding-bottom: 2px;
    transition: opacity 0.25s ease;
  }
  .contact-oval .contact-links a:hover {
    opacity: 0.55;
    font-weight: 800; /* League Mono ExtraBold — the only bold face loaded */
  }

  .contact-close {
    position: absolute;
    top: 8%;
    right: 14%;
    background: none;
    border: none;
    font-family: var(--font-caption);
    font-size: 22px;
    font-weight: 100;
    line-height: 1;
    color: var(--black);
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .contact-close:hover {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .contact-oval {
      width: min(76vw, 300px);
      aspect-ratio: 1 / 1.15;
      padding: 13% 11%;
      top: 10vh;
    }
    .contact-oval .contact-links {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>

<div class="top-bar{% if topBarTheme == 'dark' %} top-bar--dark{% endif %}" id="topBar">
  <div class="top-bar-masthead">
    <img class="top-bar-logo" src="/images/logo/logo.png" alt="Jack Leary logo">
    <span>2026</span>
    <span>Multidisciplinary Designer</span>
  </div>
  <nav class="top-bar-nav">
    {% if topBarSection != "about" %}<a href="/about/">Jack Leary</a>{% endif %}
    {% if topBarSection != "home" %}<a href="/" class="hover-red">Home</a>{% endif %}
    {% if topBarSection != "work" %}<a href="/work/" class="hover-blue">Work</a>{% endif %}
    <a href="#contact" class="top-bar-contact">Contact</a>
    {% if topBarSection != "archive" %}<a href="/archive/" class="hover-yellow">Archive</a>{% endif %}
  </nav>
</div>

<div class="contact-overlay" id="contactOverlay">
  <div class="contact-oval">
    <button class="contact-close" id="contactClose" aria-label="Close">&times;</button>
    <div class="contact-name">Jack Leary</div>
    <a class="contact-email" href="mailto:jack.leary2004@gmail.com">jack.leary2004@gmail.com</a>
    <div class="contact-links">
      <a href="https://www.instagram.com/jacklearyart/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.behance.net/jackleary3" target="_blank" rel="noopener noreferrer">Behance</a>
      <a href="https://www.linkedin.com/in/jack-leary-art" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var bar = document.getElementById("topBar");
    if (!bar) return;
    function onScroll() {
      if (window.scrollY > 4) {
        bar.classList.add("top-bar--scrolled");
      } else {
        bar.classList.remove("top-bar--scrolled");
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();

  // ---- Contact overlay: click the "Contact" nav link to drop the
  // blue/red/yellow oval down from the top instead of navigating. ----
  (function () {
    var overlay = document.getElementById("contactOverlay");
    var trigger = document.querySelector('a[href="#contact"]');
    var closeBtn = document.getElementById("contactClose");
    if (!overlay || !trigger || !closeBtn) return;

    function openContact(e) {
      if (e) e.preventDefault();
      overlay.classList.add("open");
    }
    function closeContact() {
      overlay.classList.remove("open");
    }

    trigger.addEventListener("click", openContact);
    closeBtn.addEventListener("click", closeContact);
    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) closeContact();
    });
    window.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeContact();
    });
  })();
</script>
